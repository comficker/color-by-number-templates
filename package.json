{
  "name": "color-by-number-templates",
  "version": "0.1.1",
  "description": "113 free colour-by-number / pixel grid templates as JSON and CSV, with the colour key, plus a small library and CLI to render them as SVG. Data from squarecoloring.com.",
  "keywords": [
    "color-by-number",
    "colour-by-number",
    "coloring",
    "colouring",
    "printable",
    "pixel-art",
    "pixel-grid",
    "cross-stitch",
    "coloring-pages",
    "kids",
    "dataset",
    "svg"
  ],
  "homepage": "https://www.squarecoloring.com/printable",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comficker/color-by-number-templates.git"
  },
  "bugs": {
    "url": "https://github.com/comficker/color-by-number-templates/issues"
  },
  "license": "MIT",
  "author": "Ninosaur (https://www.squarecoloring.com)",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./data/index.json": "./data/index.json",
    "./data/json/*.json": "./data/json/*.json",
    "./data/csv/*.csv": "./data/csv/*.csv"
  },
  "types": "./src/index.d.ts",
  "bin": {
    "color-by-number": "./src/cli.js"
  },
  "files": [
    "src",
    "data",
    "i18n",
    "CATALOG.md",
    "SOURCES.md",
    "LICENSE",
    "LICENSE-DATA"
  ],
  "scripts": {
    "build:data": "node tools/build-data.mjs",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false
}
